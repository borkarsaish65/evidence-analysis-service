# =============================================================================
# EVIDENCE ANALYSIS SERVICE — ENVIRONMENT CONFIGURATION
# =============================================================================
# Copy this file to .env and fill in the values.
#   cp .env.example .env
#
# Legend:
#   [REQUIRED]              — must be set; app will refuse to start without it
#   [REQUIRED if ...]       — required only when the stated condition is true
#   [OPTIONAL]              — has a safe default; override only if needed
# =============================================================================


# =============================================================================
# APPLICATION
# =============================================================================

# [OPTIONAL] Human-readable application name shown in logs and emails.
# Default: Evidence Analysis System
APP_NAME=Evidence Analysis System

# [OPTIONAL] Semantic version tag shown in the /health endpoint.
# Default: 1.0.0
APP_VERSION=1.0.0

# [OPTIONAL] Port the uvicorn server listens on when running via `python main.py`.
# Default: 8000
APP_PORT=8000

# [OPTIONAL] Enable verbose debug logging and FastAPI auto-reload.
# Accepted: true | false | 1 | 0 | yes | no | dev | prod
# Default: false
DEBUG=false

# [OPTIONAL] Base path prefix the app is mounted under behind a reverse
# proxy/gateway (e.g. "/evidence-analysis"). All routes, including /health,
# are served under this prefix. Leave empty to serve at root.
# Default: (empty)
API_BASE_PATH=


# =============================================================================
# CELERY / BACKGROUND PROCESSING
# =============================================================================

# ============================================
# EXECUTION DEFAULTS
# ============================================
DEFAULT_TENANT_CODE=default
DEFAULT_ORGANIZATION_CODE=default_code

# ============================================
# ENTITY MANAGEMENT SERVICE
# ============================================
# Base URL for external entity management service
ENTITY_MGMT_BASE_URL=https://dev.elevate-apis.shikshalokam.org

# Mandatory upstream headers (currently required by Entity Management service)
ENTITY_MGMT_TENANT_ID=shikshalokam
ENTITY_MGMT_ORIGIN=https://dev.elevate-sandbox.shikshalokam.org

# Reliability settings
ENTITY_MGMT_TIMEOUT_SECONDS=10
ENTITY_MGMT_RETRY_ATTEMPTS=2
ENTITY_MGMT_RETRY_BACKOFF_SECONDS=0.5

# Optional in-memory cache for /states endpoint
ENTITY_MGMT_CACHE_ENABLED=true
ENTITY_MGMT_STATES_CACHE_TTL_SECONDS=900

# ============================================
# FILE STORAGE CONFIGURATION
# ============================================
# Standardized cloud config (use only CLOUD_* keys)
# Provider: gcp | aws
CLOUD_STORAGE_PROVIDER=gcp

# Display/type label used by API responses (e.g., GCP, AWS, LOCAL)
CLOUD_STORAGE=GCP

# Provider-specific account identifier:
# - GCP: service-account email
# - AWS: access key id
CLOUD_STORAGE_ACCOUNTNAME=your-account-or-service-account

# Bucket settings
CLOUD_STORAGE_BUCKETNAME=your-bucket-name
CLOUD_STORAGE_BUCKET_TYPE=private

# Region / project hint:
# - AWS: set region (example: us-east-1)
# - GCP: optional (can be empty if full service-account JSON is supplied in CLOUD_STORAGE_SECRET)
CLOUD_STORAGE_REGION=

# Optional endpoint override:
# - AWS: custom S3-compatible endpoint if needed
# - GCP: optional token URI override
CLOUD_ENDPOINT=

# Provider secret:
# - GCP: service-account JSON string OR private key
# - AWS: secret access key
CLOUD_STORAGE_SECRET=

# Local storage path (not used when CLOUD_STORAGE_PROVIDER is gcp/aws)
LOCAL_STORAGE_PATH=./uploads

# ============================================
# LLM PROVIDER CONFIGURATION
# ============================================
# Select provider: gemini (default) | openrouter
LLM_PROVIDER=gemini

# ── Google Gemini ────────────────────────────
# Multiple API keys supported for rotation (at least one required when LLM_PROVIDER=gemini)
# Optional: use comma-separated keys instead of numbered vars
# GEMINI_API_KEYS=key_a,key_b,key_c
GEMINI_API_KEY_1=your_gemini_api_key_1
GEMINI_API_KEY_2=your_gemini_api_key_2
GEMINI_API_KEY_3=your_gemini_api_key_3
GEMINI_MODEL=gemini-2.5-flash

# ── OpenRouter (via OpenAI SDK) ──────────────
# Required when LLM_PROVIDER=openrouter
# Multiple API keys supported for rotation (at least one required when LLM_PROVIDER=openrouter)
OPENROUTER_API_KEY_1=your_openrouter_api_key_1
OPENROUTER_API_KEY_2=your_openrouter_api_key_2
OPENROUTER_API_KEY_3=your_openrouter_api_key_3
# Model to use via OpenRouter (any model slug listed on openrouter.ai)
OPENROUTER_MODEL=google/gemini-2.5-flash-lite
# Optional: override the OpenRouter API base URL (defaults to https://openrouter.ai/api/v1)
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ============================================
# EMAIL CONFIGURATION (SMTP)
# ============================================
# Enable/disable email notifications
IS_NOTIFICATION_ENABLED=true

# If IS_NOTIFICATION_ENABLED=true, the following SMTP settings are mandatory:
# For SendGrid SMTP, use:
# SMTP_HOST=smtp.sendgrid.net
# SMTP_USER=apikey
# SMTP_API_KEY=SG.xxxxxx
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_specific_password
SMTP_API_KEY=
SMTP_USE_TLS=true
SMTP_TIMEOUT_SECONDS=30
SMTP_MAX_RETRIES=3
SMTP_RETRY_BACKOFF_SECONDS=1
SMTP_FROM_EMAIL=noreply@evidence-analysis.com
SMTP_FROM_NAME=Evidence Analysis System
PORTAL_BASE_URL=http://localhost:5173

# ============================================
# BACKGROUND PROCESSING
# ============================================
MAX_CONCURRENT_JOBS=5
WORKER_CHECK_INTERVAL=5

# Celery + RabbitMQ
CELERY_BROKER_URL=amqp://guest:guest@localhost:5672//

# [OPTIONAL] Maximum number of automatic retries before an execution is
# marked permanently failed.
# Default: 3
CELERY_MAX_RETRIES=3

# [OPTIONAL] Celery result backend.
# rpc://  — results returned over AMQP (ephemeral; fine because status is
#           tracked in the database, not via Celery results).
# redis://localhost:6379/0 — use if you need durable result storage.
# Default: rpc://
CELERY_RESULT_BACKEND=rpc://

# [OPTIONAL] Base retry delay in seconds. Each retry doubles this value
# (exponential backoff). Retry 1 = 30s, retry 2 = 60s, retry 3 = 120s.
# Default: 30
CELERY_RETRY_BACKOFF_SECONDS=30

# [OPTIONAL] RabbitMQ queue name that the worker consumes from.
# Must match CELERY_TASK_QUEUE used by the API when publishing tasks.
# Default: execution_queue
CELERY_TASK_QUEUE=execution_queue

# [OPTIONAL] AMQP routing key used to bind tasks to the queue.
# Default: execution.process
CELERY_TASK_ROUTING_KEY=execution.process

# [OPTIONAL] Number of concurrent tasks the worker runs in parallel.
# Ignored when CELERY_WORKER_POOL=solo.
# Default: 2
CELERY_WORKER_CONCURRENCY=2

# [OPTIONAL] Celery worker pool type.
# threads  — uses Python threads; safe on macOS (no fork); recommended for dev.
# prefork  — uses forked child processes; best throughput on Linux / Docker.
# solo     — single-threaded; no concurrency; useful only for debugging.
# Default: threads
CELERY_WORKER_POOL=threads


# =============================================================================
# CLOUD STORAGE
# =============================================================================

# [OPTIONAL] Custom endpoint override.
# AWS:  S3-compatible endpoint (e.g. http://localhost:9000 for MinIO).
# GCP:  optional token URI override.
# Leave blank to use the provider default.
CLOUD_ENDPOINT=

# [REQUIRED] Display label used in API responses.
# Examples: GCP | AWS
CLOUD_STORAGE=GCP

# [REQUIRED if CLOUD_STORAGE_PROVIDER=gcp or aws]
# Provider account identity:
#   GCP — service account email (e.g. my-sa@my-project.iam.gserviceaccount.com)
#   AWS — IAM access key ID (e.g. AKIAIOSFODNN7EXAMPLE)
CLOUD_STORAGE_ACCOUNTNAME=

# [REQUIRED if CLOUD_STORAGE_PROVIDER=gcp or aws]
# Bucket access visibility.
# Accepted: private | public
# Default: private
CLOUD_STORAGE_BUCKET_TYPE=private

# [REQUIRED if CLOUD_STORAGE_PROVIDER=gcp or aws]
# Name of the GCS bucket or S3 bucket.
CLOUD_STORAGE_BUCKETNAME=your-bucket-name

# [REQUIRED] Cloud storage backend.
# Accepted: gcp | aws
CLOUD_STORAGE_PROVIDER=gcp

# [REQUIRED if CLOUD_STORAGE_PROVIDER=aws]
# AWS region where the S3 bucket is located (e.g. us-east-1).
# Optional for GCP (the service account JSON already encodes the project).
CLOUD_STORAGE_REGION=

# [REQUIRED if CLOUD_STORAGE_PROVIDER=gcp or aws]
# Provider secret credential:
#   GCP — full service account JSON string (paste the JSON contents as one line)
#          OR just the private key PEM string.
#   AWS — secret access key matching CLOUD_STORAGE_ACCOUNTNAME.
CLOUD_STORAGE_SECRET=


# =============================================================================
# CORS
# =============================================================================

# [OPTIONAL] JSON array of allowed CORS origins.
# Add your frontend URL(s) here.
# Default: ["http://localhost:5173","http://localhost:3000"]
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]


# =============================================================================
# DATABASE
# =============================================================================

# [REQUIRED] PostgreSQL connection string.
# Format: postgresql://username:password@host:port/database_name
# Local dev example: postgresql://evidence_user:evidence_password@localhost:5432/evidence_analysis
DATABASE_URL=postgresql://evidence_user:your_password@localhost:5432/evidence_analysis


# =============================================================================
# ENTITY MANAGEMENT SERVICE
# =============================================================================

# [REQUIRED] Base URL of the external Entity Management API.
ENTITY_MGMT_BASE_URL=https://dev.elevate-apis.shikshalokam.org

# [OPTIONAL] Enable in-memory cache for the /states endpoint to reduce
# upstream API calls.
# Default: true
ENTITY_MGMT_CACHE_ENABLED=true

# [REQUIRED] Origin header forwarded to the Entity Management service.
ENTITY_MGMT_ORIGIN=https://dev.elevate-sandbox.shikshalokam.org

# [OPTIONAL] Number of automatic retries on transient failures.
# Default: 2
ENTITY_MGMT_RETRY_ATTEMPTS=2

# [OPTIONAL] Base delay in seconds between retries (linear backoff).
# Default: 0.5
ENTITY_MGMT_RETRY_BACKOFF_SECONDS=0.5

# [OPTIONAL] TTL in seconds for the cached /states response.
# Default: 900 (15 minutes)
ENTITY_MGMT_STATES_CACHE_TTL_SECONDS=900

# [REQUIRED] Tenant ID header forwarded to the Entity Management service.
ENTITY_MGMT_TENANT_ID=shikshalokam

# [OPTIONAL] Request timeout in seconds for Entity Management API calls.
# Default: 10.0
ENTITY_MGMT_TIMEOUT_SECONDS=10.0


# =============================================================================
# EXECUTION / FILE PROCESSING
# =============================================================================

# [OPTIONAL] Comma-separated or JSON list of permitted upload file extensions.
# Default: [".csv"]
ALLOWED_EXTENSIONS=[".csv"]

# [OPTIONAL] Maximum number of criteria items allowed in interactive validation.
# Default: 25
CRITERIA_VALIDATE_MAX_ITEMS=25

# [OPTIONAL] Default organization code used for seed data and bootstrap only.
# Never use this in service logic for real user data.
# Default: default_code
DEFAULT_ORGANIZATION_CODE=default_code

# [OPTIONAL] Default tenant code used for seed data and bootstrap only.
# Default: default
DEFAULT_TENANT_CODE=default

# [OPTIONAL] Enable automatic (dynamic) file splitting based on row count.
# Set to false to always process the full file as a single unit.
# Default: true
ENABLE_DYNAMIC_SPLITTING=true

# [OPTIONAL] Estimated cost in USD per input row (used for pre-run cost display).
# Default: 0.001
ESTIMATED_COST_PER_INPUT_ROW=0.001

# [OPTIONAL] Estimated processing time in seconds per input row (used for ETA display).
# Default: 0.5
ESTIMATED_TIME_SECONDS_PER_INPUT_ROW=0.5

# [OPTIONAL] Delete the local execution workspace after a successful run.
# Set to false to keep files for debugging.
# Default: true
EXECUTION_CLEANUP_ON_SUCCESS=true

# [OPTIONAL] Local filesystem path where execution workspaces are created.
# Each execution gets its own subdirectory under this root.
# Default: /tmp/evidence_analysis/executions
EXECUTION_WORKSPACE_ROOT=/tmp/evidence_analysis/executions

# [OPTIONAL] Hard cap on the number of split files created per execution.
# Prevents runaway parallelism on very large files.
# Default: 100
MAX_SPLIT_FILES=100

# [OPTIONAL] Maximum number of concurrent executions processed by the
# thread-pool fallback (used when Celery is unavailable).
# Default: 5
MAX_CONCURRENT_JOBS=5

# [OPTIONAL] Maximum file upload size in bytes.
# Default: 104857600 (100 MB)
MAX_UPLOAD_SIZE=104857600

# [OPTIONAL] Files with fewer rows than this threshold are processed as a
# single file (splitting overhead outweighs benefit).
# Default: 200
MIN_ROWS_FOR_SPLITTING=200

# [OPTIONAL] Target rows per split file used by the dynamic splitting logic.
# Lower = more parallelism; higher = fewer files.
# Default: 200
OPTIMAL_ROWS_PER_SPLIT=200

# [OPTIONAL] Relative or absolute path to the pre-processor script.
# Default: scripts/pre-processor/1-pre-processor.py
PREPROCESS_SCRIPT_PATH=scripts/pre-processor/1-pre-processor.py

# [OPTIONAL] Hard cap on the number of rows the processor script will handle.
# Set to 0 for unlimited.
# Default: 0
PROCESSOR_MAX_ROWS=0

# [OPTIONAL] Strip rows with no AI-evaluation result (notValidated/Failed/Unsupported/blank-tag)
# from the delivered output CSV before upload. The unfiltered merged output is always uploaded
# to cloud storage first regardless of this setting, so the full audit trail is never lost even
# when set to false.
# Default: true
REMOVE_INVALID_ROWS_FROM_OUTPUT=true


# [OPTIONAL] Relative or absolute path to the main processor script.
# Default: scripts/processor/1-main-parallel-script.py
PROCESSOR_SCRIPT_PATH=scripts/processor/1-main-parallel-script.py

# [OPTIONAL] Relative or absolute path to the post-processing cleanup script (strips
# notValidated/Failed/blank-tag rows from the delivered output CSV; see
# REMOVE_INVALID_ROWS_FROM_OUTPUT above).
# Default: scripts/processor/2-remove-nonvalidated-and-empty-evidences.py
CLEANUP_SCRIPT_PATH=scripts/processor/2-remove-nonvalidated-and-empty-evidences.py

# [OPTIONAL] Manual rows-per-split override.
# Only used when SPLIT_FILES=yes. Set to 0 to let dynamic logic decide.
# Default: 0
ROWS_PER_FILE=0

# [OPTIONAL] Expiry in seconds for presigned download URLs.
# Default: 600 (10 minutes)
SIGNED_DOWNLOAD_URL_EXPIRY_SECONDS=600

# [OPTIONAL] Expiry in seconds for presigned upload URLs.
# Default: 900 (15 minutes)
SIGNED_UPLOAD_URL_EXPIRY_SECONDS=900

# [OPTIONAL] Manual splitting override.
# yes / true  — always split (uses ROWS_PER_FILE if set, else dynamic).
# no  / false — never split regardless of file size.
# (empty)     — let ENABLE_DYNAMIC_SPLITTING decide automatically.
# Default: (empty — dynamic mode)
SPLIT_FILES=

# [OPTIONAL] Upper bound of the target rows-per-split range used by dynamic logic.
# Default: 500
TARGET_ROWS_PER_SPLIT_MAX=500

# [OPTIONAL] Lower bound of the target rows-per-split range used by dynamic logic.
# Default: 100
TARGET_ROWS_PER_SPLIT_MIN=100

# [OPTIONAL] How often (in seconds) the background worker checks queue state.
# Default: 5
WORKER_CHECK_INTERVAL=5


# =============================================================================
# GEMINI AI
# =============================================================================

# [REQUIRED] Primary Gemini API key (at least one of KEY_1/KEY_2/KEY_3 required).
# Keys are rotated automatically if multiple are supplied.
GEMINI_API_KEY_1=your_gemini_api_key_1

# [OPTIONAL] Second Gemini API key for rotation.
GEMINI_API_KEY_2=

# [OPTIONAL] Third Gemini API key for rotation.
GEMINI_API_KEY_3=

# [OPTIONAL] Gemini model name passed to the processor script.
# Default: gemini-2.5-flash
GEMINI_MODEL=gemini-2.5-flash


# =============================================================================
# JWT AUTHENTICATION
# =============================================================================

# [OPTIONAL] JWT signing algorithm.
# Default: HS256
JWT_ALGORITHM=HS256

# [OPTIONAL] Token lifetime in minutes. 1440 = 24 hours.
# Default: 1440
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# [REQUIRED] Secret key used to sign and verify JWT tokens.
# Generate a strong key: openssl rand -hex 32
JWT_SECRET_KEY=your_jwt_secret_key_here_use_openssl_rand_hex_32


# =============================================================================
# SMTP / NOTIFICATIONS
# =============================================================================

# [OPTIONAL] Enable email notifications on execution completion or failure.
# Default: true
IS_NOTIFICATION_ENABLED=true

# [OPTIONAL] Base URL of the frontend portal, included in notification emails.
# Default: http://localhost:5173
PORTAL_BASE_URL=http://localhost:5173

# [OPTIONAL] SendGrid-compatible API key.
# For SendGrid: set SMTP_HOST=smtp.sendgrid.net, SMTP_USER=apikey, this to SG.xxxx
SMTP_API_KEY=

# [REQUIRED if IS_NOTIFICATION_ENABLED=true]
# Sender email address shown in the From header.
SMTP_FROM_EMAIL=noreply@your-domain.com

# [OPTIONAL] Sender display name shown in email clients.
# Default: Evidence Analysis System
SMTP_FROM_NAME=Evidence Analysis System

# [REQUIRED if IS_NOTIFICATION_ENABLED=true]
# SMTP server hostname.
# Gmail:     smtp.gmail.com
# SendGrid:  smtp.sendgrid.net
# Mailgun:   smtp.mailgun.org
SMTP_HOST=smtp.gmail.com

# [OPTIONAL] Maximum SMTP delivery retry attempts.
# Default: 3
SMTP_MAX_RETRIES=3

# [REQUIRED if IS_NOTIFICATION_ENABLED=true]
# SMTP account password or app-specific password.
# Gmail users: create an App Password at https://myaccount.google.com/apppasswords
SMTP_PASSWORD=your_app_specific_password

# [OPTIONAL] SMTP server port.
# 587 = STARTTLS (recommended), 465 = SSL, 25 = plain (not recommended)
# Default: 587
SMTP_PORT=587

# [OPTIONAL] Base delay in seconds between SMTP retry attempts.
# Default: 1
SMTP_RETRY_BACKOFF_SECONDS=1

# [OPTIONAL] SMTP connection timeout in seconds.
# Default: 30
SMTP_TIMEOUT_SECONDS=30

# [OPTIONAL] Enable STARTTLS encryption on the SMTP connection.
# Default: true
SMTP_USE_TLS=true

# [REQUIRED if IS_NOTIFICATION_ENABLED=true]
# SMTP login username.
# Gmail:    your full Gmail address
# SendGrid: the literal string "apikey"
SMTP_USER=your_email@gmail.com
